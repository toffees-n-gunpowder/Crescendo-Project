# Crescendo - environment template
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed: CSE216 §4 lists "leaving credentials, connection
# strings or API keys committed in the repository" as a defect.
#
#     cp .env.example .env
#
# Nothing here is a real credential.

# --- Django ---------------------------------------------------------------
# Generate one with:
#   python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits+'!@#$%^&*(-_=+)') for _ in range(50)))"
DJANGO_SECRET_KEY=replace-me-with-a-50-character-random-string

# --- PostgreSQL (Neon) ----------------------------------------------------
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=your-project.region.aws.neon.tech
DB_PORT=5432

# --- Jamendo API ----------------------------------------------------------
# Register a free application at https://devportal.jamendo.com/ to get one.
# The seeders refuse to run without it; nothing else in the app needs it.
JAMENDO_CLIENT_ID=your_jamendo_client_id
