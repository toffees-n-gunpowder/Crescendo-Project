// DBML (Database Markup Language) Schema for Crescendo

Table users {
  id integer [primary key, increment]
  username varchar(150) [unique, not null]
  password varchar(128) [not null]
  email varchar(254) [not null]
  account_type varchar(20) [default: 'listener', note: 'listener or artist']
  subscription_type varchar(20) [default: 'free', note: 'free or premium']
  is_staff boolean [default: false]
  is_superuser boolean [default: false]
  created_at timestamp [default: `now()`]
}

Table artists {
  id integer [primary key, increment]
  user_id integer [null, unique, ref: - users.id, note: 'O2O link to users for claimed profiles, ON DELETE SET NULL']
  name varchar(255) [not null]
  bio text
  verified boolean [default: false]

}

Table albums {
  id integer [primary key, increment]
  artist_id integer [not null, ref: > artists.id, note: 'ON DELETE CASCADE']
  title varchar(255) [not null]
  release_date date [not null]
  cover_url varchar(500)
  created_by_id integer [null, ref: > users.id, note: 'ON DELETE SET NULL']

  indexes {
    created_by_id
  }

}

Table genres {
  id integer [primary key, increment]
  name varchar(100) [unique, not null]
}

Table eras {
  id integer [primary key, increment]
  name varchar(100) [unique, not null, note: 'e.g. 1950s, Baroque, Romantic']
  description text
}

Table tracks {
  id integer [primary key, increment]
  album_id integer [not null, ref: > albums.id, note: 'ON DELETE CASCADE']
  genre_id integer [null, ref: > genres.id, note: 'ON DELETE SET NULL']
  era_id integer [null, ref: > eras.id, note: 'ON DELETE SET NULL']
  title varchar(255) [not null]
  duration_sec integer [not null, note: 'CHECK: duration_sec >= 0']
  track_number integer [default: 1, note: 'CHECK: track_number >= 0']
  approval_status varchar(20) [default: 'approved', note: 'pending, approved, rejected']
  submitted_by_id integer [null, ref: > users.id, note: 'ON DELETE SET NULL']
  submitted_at timestamp [null]
  reviewed_by_id integer [null, ref: > users.id, note: 'ON DELETE SET NULL']
  reviewed_at timestamp [null]
  review_note varchar(500) [default: '']

  indexes {
    approval_status
    submitted_by_id
  }

}

Table playlists {
  id integer [primary key, increment]
  user_id integer [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  name varchar(255) [not null]
  is_public boolean [default: true]
  created_at timestamp [default: `now()`]

}

Table playlist_tracks {
  id integer [primary key, increment]
  playlist_id integer [not null, ref: > playlists.id, note: 'ON DELETE CASCADE']
  track_id integer [not null, ref: > tracks.id, note: 'ON DELETE CASCADE']
  position integer [default: 1, note: 'CHECK: position >= 0']
  added_at timestamp [default: `now()`]

  indexes {
    (playlist_id, track_id) [unique]
  }

}

Table personal_groups {
  id integer [primary key, increment]
  owner_id integer [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  name varchar(255) [not null]
  description text
  is_public boolean [default: true]
  created_at timestamp [default: `now()`]

}

Table group_tracks {
  id integer [primary key, increment]
  personal_group_id integer [not null, ref: > personal_groups.id, note: 'ON DELETE CASCADE']
  track_id integer [not null, ref: > tracks.id, note: 'ON DELETE CASCADE']
  added_at timestamp [default: `now()`]

  indexes {
    (personal_group_id, track_id) [unique]
  }

}

Table group_playlists {
  id integer [primary key, increment]
  personal_group_id integer [not null, ref: > personal_groups.id, note: 'ON DELETE CASCADE']
  playlist_id integer [not null, ref: > playlists.id, note: 'ON DELETE CASCADE']
  added_at timestamp [default: `now()`]

  indexes {
    (personal_group_id, playlist_id) [unique]
  }

}

Table group_reviews {
  id integer [primary key, increment]
  group_id integer [not null, ref: > personal_groups.id, note: 'ON DELETE CASCADE']
  reviewer_id integer [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  rating integer [not null, note: '1 to 5 stars, CHECK: rating >= 0']
  review_text text [not null]
  created_at timestamp [default: `now()`]

  indexes {
    (group_id, reviewer_id) [unique]
  }

}

Table play_histories {
  id integer [primary key, increment]
  user_id integer [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  track_id integer [not null, ref: > tracks.id, note: 'ON DELETE CASCADE']
  played_at timestamp [default: `now()`]

}

Table follows {
  id integer [primary key, increment]
  follower_id integer [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  artist_id integer [not null, ref: > artists.id, note: 'ON DELETE CASCADE']
  created_at timestamp [default: `now()`]

  indexes {
    (follower_id, artist_id) [unique]
  }

}

Table liked_tracks {
  id integer [primary key, increment]
  user_id integer [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  track_id integer [not null, ref: > tracks.id, note: 'ON DELETE CASCADE']
  created_at timestamp [default: `now()`]

  indexes {
    (user_id, track_id) [unique]
  }

}

Table app_sessions {
  session_key varchar(64) [primary key]
  user_id integer [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  created_at timestamp [default: `now()`]
  expires_at timestamp [not null]
  user_agent varchar(255) [default: '']
  ip_address varchar(45) [default: '']

  indexes {
    user_id
    expires_at
  }

}
